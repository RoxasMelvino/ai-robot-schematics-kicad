# ==============================================================================
# KiCad Version Control Gitignore Template
# Matches official GitHub templates for modern KiCad (v6, v7, v8, and v9)
# ==============================================================================

# Temporary, autosave, and local backup files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb

# Automated project backup directories
*-backups/

# Local workspace/user-specific configuration settings
# (Contains local window positions, panel states, and absolute file paths)
*.kicad_prl
fp-info-cache

# Netlists and intermediate build files (can be regenerated safely)
*.net
*.xml

# Standard manufacturing output folders
# (Uncomment these if you want to block Gerber and CAD export folders from Git)
# Gerbers/
# Output/
# _gbr/

.history

